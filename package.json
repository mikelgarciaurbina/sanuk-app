{
  "name": "sanuk",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/noto-sans-thai-looped": "^0.4.2",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-speech": "~58.0.4",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "postinstall": "patch-package",
    "eas-build-post-install": "patch-package --error-on-fail",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "build:testflight": "npx eas-cli@latest build --platform ios --profile production",
    "submit:testflight": "npx eas-cli@latest submit --platform ios --profile production",
    "test:layout": "node --test scripts/viewport.test.mts",
    "test:audio": "node --test scripts/audio.test.mts",
    "test:eco": "node --test scripts/eco-audio.test.mts",
    "test:reminders": "node --test scripts/reminders.test.mts",
    "temario": "node scripts/temario/revisar.mts",
    "temario:nivel": "node scripts/temario/nivel.mts",
    "temario:test": "node --test scripts/temario/temario.test.mts",
    "sfx": "node scripts/make-sfx.mjs",
    "noi:svg": "node scripts/render-noi.mts noi-svg",
    "icons:svg": "node scripts/make-icons.mts icons-svg",
    "stores:update": "python3 stores/sources/prepare.py && python3 stores/sources/compose-screenshots.py && python3 stores/sources/catalog.py && python3 stores/sources/validate.py",
    "stores:validate": "python3 stores/sources/validate.py",
    "stores:pack": "python3 stores/sources/pack.py"
  },
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "expo-audio"
        ]
      }
    }
  },
  "private": true
}
